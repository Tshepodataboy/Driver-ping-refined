# ============================================================================
# DRIVER PING - ENVIRONMENT CONFIGURATION
# ============================================================================

# ----------------------------------------------------------------------------
# 1. SUPABASE POSTGRESQL DATABASE CONFIGURATION (REQUIRED FOR PERSISTENCE)
# ----------------------------------------------------------------------------
# In your Supabase Dashboard: Go to Project Settings -> Database -> Connection string
# Choose URI (Node.js / Transaction Pooler or Direct):
# Format: postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres"

# Optional alternative connection variable name:
# SUPABASE_DB_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres"

# Supabase Project URL & API Keys (from Project Settings -> API)
SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
SUPABASE_ANON_KEY="your_supabase_publishable_or_anon_key"
# Do not expose or use the service-role key for client authentication.

# ----------------------------------------------------------------------------
# 2. SESSION AUTHENTICATION SECURITY
# ----------------------------------------------------------------------------
# Cryptographic secret used to sign and verify session JWT tokens.
# You can use your Supabase JWT Secret (Project Settings -> API -> JWT Secret) or any strong 32+ character random string.
JWT_SECRET="your_secure_random_jwt_secret_key_minimum_32_characters"

# ----------------------------------------------------------------------------
# 3. AI STUDIO RUNTIME VARIABLES
# ----------------------------------------------------------------------------
# Automatically injected by AI Studio at runtime
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
